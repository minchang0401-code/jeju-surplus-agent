# 프로젝트 루트에서 이 파일을 .env로 복사하세요. 실제 비밀값은 넣어 배포하지 마세요.
# 상세 설명: docs/manual.md 3장
# 읽기 우선순위: 프로세스 환경변수 > .env > eval.env (빈 값도 우선 적용)
# eval.env는 별도 제공된 경우에만 읽으며 Git에 포함되지 않습니다.
# 값을 바꾼 뒤 서버를 종료하고 다시 실행하세요.

# 기본은 API 호출 없이 규칙 기반 체험입니다.
# LLM을 쓰려면 none을 gemini / openai / upstage / anthropic 중 하나로 변경하세요.
LLM_PROVIDER=none
LLM_API_KEY=
# 비우면 config.py의 해당 공급자 기본 모델. 실제 이용 가능한 모델명을 확인하세요.
LLM_MODEL=

# 데이터 수집에만 필요: 제주데이터허브 579·862·1225·1226 프로젝트 접근 권한
JEJU_DATAHUB_PROJECT_KEY=
# 과거 ASOS 시간 관측 수집과 학습 자료 갱신용
KMA_APIHUB_KEY=
# 공공데이터포털 일반 인증키(Decoding), 기상청 단기·중기예보 각각 활용신청 필요
DATA_GO_KR_KEY=

# 선택: 카카오맵 JavaScript 키. REST API 키와 다릅니다.
# 앱을 여는 실제 도메인/포트의 Web 등록 필요. 없으면 Leaflet/OpenStreetMap 사용.
# 이 키는 지도 실행 시 브라우저에서 사용되므로 도메인 제한으로 관리하세요.
KAKAO_JS_KEY=
