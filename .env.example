# 이 파일을 복사해 .env 로 이름을 바꾼 뒤 값을 채우세요. .env 는 절대 제출·업로드하지 마세요.
# 발급 방법: docs/manual.md 3-1

# 데이터
JEJU_DATAHUB_PROJECT_KEY=   # 제주데이터허브 프로젝트키 (579·1226·1225·862 수집용)
KMA_APIHUB_KEY=             # 기상청 API허브 인증키 (과거 시간별 관측, 학습용)
DATA_GO_KR_KEY=             # 공공데이터포털 일반 인증키(Decoding) (단기예보, 화면에서 자동 갱신)

# 에이전트 LLM: gemini / openai / upstage / anthropic / none(규칙 기반)
LLM_PROVIDER=gemini
LLM_API_KEY=                # Gemini API 키 (Google AI Studio). 비우면 규칙 기반으로 동작
LLM_MODEL=                  # 비우면 config.py 의 기본 모델 (gemini-3.5-flash-lite)
